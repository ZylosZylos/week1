#include <stdio.h>

#define N_PROCESS 5
#define TIME_SLICE 1

#define TASK_WAITING 0
#define TASK_READY 1
#define TASK_RUNNING 2
#define TASK_OVER 3

int process[N_PROCESS][2] = {
    {0, 3},
    {2, 6},
    {4, 4},
    {6, 5},
    {8, 2}
};

int priority_init[N_PROCESS] = {2, 5, 2, 4, 3};

struct task_struct {
    long pid;
    long state;
    long priority;
    long counter;
    long start_time;
    long excute_time;
    long left_time;
};

struct run_q {
    struct task_struct *data;
    struct run_q *next;
};

void init_task(struct task_struct task[])
{
    int i;

    for (i = 0; i < N_PROCESS; i++) {
        task[i].pid = i + 1;
        task[i].state = TASK_WAITING;
        task[i].priority = priority_init[i];
        task[i].counter = task[i].priority;
        task[i].start_time = process[i][0];
        task[i].excute_time = process[i][1];
        task[i].left_time = process[i][1];
    }
}

int get_total_excute_time(void)
{
    int i;
    int total = 0;

    for (i = 0; i < N_PROCESS; i++) {
        total += process[i][1];
    }

    return total;
}

void init_result(char result[][64], int totalExcuteTime)
{
    int i;
    int j;

    for (i = 0; i < N_PROCESS; i++) {
        for (j = 0; j < totalExcuteTime; j++) {
            result[i][j] = ' ';
        }
        result[i][totalExcuteTime] = '\0';
    }
}

void print_process(void)
{
    int i;

    printf("task id   start  excute\n");
    for (i = 0; i < N_PROCESS; i++) {
        printf("task %2d: %6d %6d\n", i + 1, process[i][0], process[i][1]);
    }
}

void print_result(char result[][64], int totalExcuteTime)
{
    int i;
    int j;

    printf("time    : 0");
    for (j = 1; j < totalExcuteTime; j++) {
        printf(" ");
    }
    printf("%d\n", totalExcuteTime);

    for (i = 0; i < N_PROCESS; i++) {
        printf("task %2d: %s\n", i + 1, result[i]);
    }
}

void enqueue(struct run_q **tail, struct run_q *node)
{
    if (*tail == NULL) {
        node->next = node;
        *tail = node;
    } else {
        node->next = (*tail)->next;
        (*tail)->next = node;
        *tail = node;
    }
}

struct run_q *dequeue(struct run_q **tail)
{
    struct run_q *head;

    if (*tail == NULL) {
        return NULL;
    }

    head = (*tail)->next;
    if (head == *tail) {
        *tail = NULL;
    } else {
        (*tail)->next = head->next;
    }
    head->next = NULL;

    return head;
}

void add_ready_task(struct task_struct task[], struct run_q qnode[],
                    struct run_q **tail, int now)
{
    int i;

    for (i = 0; i < N_PROCESS; i++) {
        if (task[i].state == TASK_WAITING && task[i].start_time <= now) {
            task[i].state = TASK_READY;
            qnode[i].data = &task[i];
            qnode[i].next = NULL;
            enqueue(tail, &qnode[i]);
        }
    }
}

void schedule_f(void)
{
    struct task_struct task[N_PROCESS];
    char result[N_PROCESS][64];
    int i;
    int now = 0;
    int totalExcuteTime = get_total_excute_time();

    init_task(task);
    init_result(result, totalExcuteTime);
    print_process();

    for (i = 0; i < N_PROCESS; i++) {
        int j;
        if (now < task[i].start_time) {
            now = task[i].start_time;
        }
        for (j = 0; j < task[i].excute_time; j++) {
            result[i][now++] = '#';
        }
    }

    print_result(result, totalExcuteTime);
}

void schedule_r(void)
{
    struct task_struct task[N_PROCESS];
    struct run_q qnode[N_PROCESS];
    struct run_q *tail = NULL;
    char result[N_PROCESS][64];
    int now = 0;
    int finished = 0;
    int totalExcuteTime = get_total_excute_time();

    init_task(task);
    init_result(result, totalExcuteTime);
    print_process();

    while (finished < N_PROCESS) {
        struct run_q *node;
        struct task_struct *cur;
        int i;
        int run_time;

        add_ready_task(task, qnode, &tail, now);

        if (tail == NULL) {
            now++;
            continue;
        }

        node = dequeue(&tail);
        cur = node->data;
        cur->state = TASK_RUNNING;
        run_time = cur->left_time < TIME_SLICE ? cur->left_time : TIME_SLICE;

        for (i = 0; i < run_time; i++) {
            result[cur->pid - 1][now++] = '#';
            cur->left_time--;
        }

        add_ready_task(task, qnode, &tail, now);

        if (cur->left_time == 0) {
            cur->state = TASK_OVER;
            finished++;
        } else {
            cur->state = TASK_READY;
            enqueue(&tail, node);
        }
    }

    print_result(result, totalExcuteTime);
}

int select_task_p(struct task_struct task[], int now)
{
    int i;
    int selected = -1;

    for (i = 0; i < N_PROCESS; i++) {
        if (task[i].left_time > 0 &&
            task[i].start_time <= now &&
            task[i].counter > 0) {
            if (selected == -1 ||
                task[i].counter > task[selected].counter ||
                (task[i].counter == task[selected].counter &&
                 task[i].pid > task[selected].pid)) {
                selected = i;
            }
        }
    }

    return selected;
}

int has_ready_task(struct task_struct task[], int now)
{
    int i;

    for (i = 0; i < N_PROCESS; i++) {
        if (task[i].left_time > 0 && task[i].start_time <= now) {
            return 1;
        }
    }

    return 0;
}

void update_counter(struct task_struct task[], int now)
{
    int i;

    for (i = 0; i < N_PROCESS; i++) {
        if (task[i].left_time > 0 && task[i].start_time <= now) {
            task[i].counter = task[i].counter / 2 + task[i].priority;
        }
    }
}

void schedule_p(void)
{
    struct task_struct task[N_PROCESS];
    char result[N_PROCESS][64];
    int i;
    int now = 0;
    int finished = 0;
    int totalExcuteTime = get_total_excute_time();

    init_task(task);
    init_result(result, totalExcuteTime);
    print_process();

    printf("任务优先级依次为： ");
    for (i = 0; i < N_PROCESS; i++) {
        printf("%ld  ", task[i].priority);
    }
    printf("\n");

    while (finished < N_PROCESS) {
        int selected = select_task_p(task, now);

        if (selected == -1) {
            if (has_ready_task(task, now)) {
                update_counter(task, now);
            } else {
                now++;
            }
            continue;
        }

        result[selected][now++] = '#';
        task[selected].counter--;
        task[selected].left_time--;

        if (task[selected].left_time == 0) {
            task[selected].state = TASK_OVER;
            finished++;
        }
    }

    print_result(result, totalExcuteTime);
}

int main(void)
{
    char choice;
    void (*schedule)(void);

    while (1) {
        printf("please choice the schedule measure:\n");
        printf("p : 基于优先级的调度策略\n");
        printf("f : 先到先服务的调度策略\n");
        printf("r : 轮循的调度策略\n");
        printf("q : 退出\n");
        printf("choice = ");

        choice = getchar();
        if (choice == '\n') {
            choice = getchar();
        }

        switch (choice) {
        case 'p':
            schedule = schedule_p;
            break;
        case 'f':
            schedule = schedule_f;
            break;
        case 'r':
            schedule = schedule_r;
            break;
        case 'q':
            return 0;
        default:
            schedule = NULL;
            printf("please input the true symbol(p or f or r)!\n\n");
            continue;
        }

        schedule();
    }
}
